# =====================
# Python cache
# =====================
__pycache__/
*.pyc

# =====================
# Virtual environments
# =====================
.venv/
venv/

# =====================
# VS Code settings
# =====================
.vscode/

# =====================
# Datasets & media
# =====================
# dataset/deck/ and dataset/troops/ are tracked as empty placeholder
# folders (see their .gitkeep files) so a fresh clone already has them --
# their actual contents (the downloaded datasets) stay ignored.
dataset/*
!dataset/deck/
!dataset/troops/
dataset/deck/*
!dataset/deck/.gitkeep
dataset/troops/*
!dataset/troops/.gitkeep
datasets/
gifs/
**/*.jpg
**/*.jpeg
**/*.webp
**/*.mp4

# =====================
# YOLO / Ultralytics
# =====================
# runs/ is tracked as an empty placeholder folder (see its .gitkeep) --
# actual training output stays ignored.
runs/*
!runs/.gitkeep
*.pt

# =====================
# RL training checkpoints
# =====================
checkpoints/

# =====================
# Secrets / credentials
# =====================
*accounts*
*passes*

# =====================
# Git worktrees
# =====================
.worktrees/

# =====================
# Claude Code local state
# =====================
.claude/
CLAUDE.md

# =====================
# Work-in-progress / not ready for commit
# =====================
unused/